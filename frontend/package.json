{
  "name": "immunity-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/csp-check.mjs",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.6.2",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.10",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.8.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
