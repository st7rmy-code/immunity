 "components": {
  "schemas": {
   "AttemptIn": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "call",
       "chat",
       "site",
       "card",
       "item"
      ],
      "title": "Kind"
     },
     "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,48}$",
      "title": "Scenario"
     },
     "result": {
      "type": "string",
      "enum": [
       "ok",
       "warn",
       "bad"
      ],
      "title": "Result"
     },
     "score": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score"
     },
     "markers": {
      "items": {
       "type": "string",
       "pattern": "^[a-z0-9_]{1,48}$"
      },
      "type": "array",
      "maxItems": 6,
