  "/api/v1/scenarios": {
   "get": {
    "tags": [
     "content"
    ],
    "summary": "Сценарии тренировок",
    "description": "Список без ответов: признак «честный/мошеннический» в списке не раскрывается.",
    "operationId": "scenarios_api_v1_scenarios_get",
    "parameters": [
     {
      "name": "kind",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "call",
          "chat",
          "site",
          "card",
          "item"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Kind"
      }
     },
     {
      "name": "skill",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 32
        },
        {
         "type": "null"
        }
       ],
       "title": "Skill"
      }
     },
     {
      "name": "audience",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 20
        },
        {
         "type": "null"
        }
       ],
       "title": "Audience"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ScenarioBrief"
         },
         "title": "Response Scenarios Api V1 Scenarios Get"
