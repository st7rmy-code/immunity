# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.
IMMUNITY_ENV=dev
IMMUNITY_DATABASE_URL=postgresql+psycopg://immunity:immunity_dev@localhost:5432/immunity
# Минимум 32 случайных символа: python -c "import secrets;print(secrets.token_urlsafe(48))"
IMMUNITY_JWT_SECRET=
IMMUNITY_JWT_TTL_MINUTES=60
IMMUNITY_CORS_ORIGINS=["http://localhost:5173"]
IMMUNITY_AUDIO_BASE_URL=/audio/
