# Скопируйте в .env и заполните. Файл .env не попадает в git.
PORT=8080

# Вариант 1: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Вариант 2: любой OpenAI-совместимый API (в том числе российские провайдеры, если поддерживают этот формат)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://…/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MODEL_QUICK=
